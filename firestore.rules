rules_version = '2';
// PC통신 실시간 대화방 - Firebase 콘솔 > Firestore Database > 규칙 에 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{database}/documents {

    // 손님(익명)이 아닌 가입 회원인지
    function isMember() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 대화실 (기존과 같은 경로)
    match /chat_rooms/{room}/messages/{id} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // 게시판 · 동호회 게시판
    match /boards/{board}/posts/{post} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      // 조회수 · 댓글수만 누구나 올릴 수 있음
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'comments']);
      // 자기 글만 삭제
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /comments/{c} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    // 한줄메모
    match /memos/{id} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // 자료실 (그림 자료실 · 공개 자료실) — 올리기는 회원만, 지우기는 올린 사람만
    match /pds/{area}/items/{id} {
      allow read: if true;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /chunks/{c} {
        allow read: if true;
        allow create: if isMember() && request.resource.data.data.size() <= 750000;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/pds/$(area)/items/$(id)).data.uid == request.auth.uid;
      }
    }

    // 접속자 목록 (자기 것만 쓰기)
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
